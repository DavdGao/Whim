{
    "name": "@whimkit/plugin-dashscope",
    "version": "0.1.0",
    "type": "module",
    "whim": {
        "api": "1.0",
        "host": "./dist/host.js",
        "contributes": {
            "credentialTypes": [
                "api-key"
            ],
            "adapters": [
                "responses"
            ]
        },
        "category": "models",
        "cards": "./cards",
        "locales": "./locales",
        "icon": "./icons/bailian.svg",
        "icons": {
            "qwen": "./icons/qwen.svg"
        }
    },
    "exports": {
        ".": {
            "types": "./dist/host.d.ts",
            "import": "./dist/host.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "cards",
        "locales",
        "icons"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --test \"dist/**/*.test.js\""
    },
    "dependencies": {
        "@whimkit/openai-protocol": "workspace:*",
        "zod": "^4.1.12"
    },
    "peerDependencies": {
        "@whimkit/core": "0.1.0"
    },
    "devDependencies": {
        "@whimkit/core": "workspace:*",
        "@types/node": "^24.10.0"
    }
}
