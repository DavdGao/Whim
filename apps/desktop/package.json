{
    "name": "@whimkit/desktop",
    "productName": "Whim",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "node scripts/build.mjs && vite build",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "start": "electron .",
        "package": "electron-builder --mac --publish never"
    },
    "dependencies": {
        "@whimkit/agent": "workspace:*",
        "@whimkit/core": "workspace:*",
        "@whimkit/plugin-arxiv": "workspace:*",
        "@whimkit/plugin-claude-code": "workspace:*",
        "@whimkit/plugin-codex": "workspace:*",
        "@whimkit/plugin-dashscope": "workspace:*",
        "@whimkit/plugin-tavily": "workspace:*",
        "@whimkit/plugin-typesafe": "workspace:*",
        "@whimkit/tools": "workspace:*"
    },
    "devDependencies": {
        "@streamdown/math": "^1.0.3",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^24.10.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@whimkit/client": "workspace:*",
        "@whimkit/ui": "workspace:*",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "electron": "45.2.2",
        "electron-builder": "^26.18.0",
        "electron-builder-squirrel-windows": "^26.18.0",
        "esbuild": "^0.28.2",
        "katex": "^0.16.47",
        "lucide-react": "^1.67.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8",
        "streamdown": "^2.7.1",
        "tailwindcss": "^4.3.4",
        "use-stick-to-bottom": "^1.1.6",
        "vite": "^8.3.5",
        "zod": "^4.1.12"
